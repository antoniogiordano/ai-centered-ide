{
  "name": "ai-first-ide",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm rebuild better-sqlite3 || true; pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @ai-ide/desktop dev",
    "rebuild:electron": "node scripts/rebuild-native-for-electron.mjs",
    "internal-build": "node scripts/internal-build.mjs",
    "postinstall": "pnpm rebuild esbuild || true; node scripts/ensure-electron.mjs || true; node scripts/rebuild-native-for-electron.mjs || true"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "keytar",
      "node-pty"
    ]
  }
}
